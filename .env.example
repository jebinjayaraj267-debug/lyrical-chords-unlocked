# Optional: defaults to the public ChordMini service.
CHORDMINI_API_URL=https://chordmini.me
# Needed only when using the public service; self-hosted ChordMiniApp usually does not need it.
CHORDMINI_APP_CHECK_TOKEN=

# Demucs must be installed in the server's Python environment.
# Override this when the app runs outside the shell where Demucs is installed.
DEMUCS_PYTHON=.venv-demucs/bin/python
DEMUCS_MODEL=htdemucs